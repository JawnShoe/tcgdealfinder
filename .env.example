DATABASE_URL=
EBAY_APP_ID=
EBAY_CLIENT_SECRET=
EBAY_AFFILIATE_CAMPAIGN_ID=
EBAY_AFFILIATE_CUSTOM_ID=

# Open Exchange Rates API key (required for automated FX rate updates)
# Get yours at: https://openexchangerates.org
OPEN_EXCHANGE_RATES_APP_ID=

# PokémonTCG.io API key (for catalog import)
# Get yours at: https://pokemontcg.io
POKEMONTCG_IO_API_KEY=

# Admin secret for /api/admin/login
# Generate a secure random token for production use
ADMIN_SECRET=

# Debug admin token for /debug/exclusions quarantine page
# Generate a secure random token for production use
DEBUG_ADMIN_TOKEN=

# Sentry DSN for error tracking (optional, server-side only)
# Get yours at: https://sentry.io
SENTRY_DSN=

# SendGrid API key for email alerts (optional until alerts go live)
# Get yours at: https://sendgrid.com
SENDGRID_API_KEY=

# Email sender address for alerts (required if SENDGRID_API_KEY is set)
# Must be a verified sender in your SendGrid account
ALERTS_EMAIL_FROM=alerts@yourdomain.com

# Base URL for email links (used in unsubscribe links)
# Set to your production domain in deployment
SITE_BASE_URL=https://yourdomain.com

# --- Tier 2 Feature Flags ---
# These flags control Tier 2 MVP features. All default to OFF (false).
# Set to "true" to enable each feature.

# Enable DB-backed watchlist (replaces localStorage)
# When OFF: Watchlist API returns 501 Not Implemented
WATCHLIST_DB_ENABLED=

# Enable email alerts system
# When OFF: Alert subscription endpoints return 501 Not Implemented
ALERTS_ENABLED=

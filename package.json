{
  "name": "tcg-deal-finder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "lint-staged",
    "test": "npm run test:unit",
    "test:unit": "tsx --test lib/__tests__/unit/*.test.ts scripts/__tests__/unit/*.test.ts",
    "test:integration": "tsx --test lib/__tests__/integration/*.test.ts",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed-cards.ts",
    "db:debug": "tsx scripts/debug-listings.ts",
    "historicals:update": "tsx scripts/update-historical-prices.ts",
    "rebuild:historicals": "tsx scripts/update-historical-prices.ts",
    "sold:update": "ts-node --esm scripts/update-sold-listings.ts",
    "listings:update": "tsx scripts/update-listings.ts",
    "ebay:rates": "tsx scripts/ebay-rate-limits.ts",
    "alerts:check": "tsx scripts/check-alerts.ts",
    "debug:discounts": "tsx scripts/debug-discounts.ts",
    "collector:backfill": "tsx scripts/backfill-collector-numbers.ts",
    "confidence:backfill": "tsx scripts/backfill-deal-confidence.ts",
    "cards:language:backfill": "tsx scripts/backfill-card-language.ts",
    "market:backfill": "tsx scripts/backfill-market.ts",
    "import:tcg-catalog": "tsx scripts/import-tcgplayer-catalog.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.32.1",
    "@types/dotenv": "^6.1.1",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "next": "14.2.35",
    "pg": "^8.11.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.5.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,json,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  }
}
